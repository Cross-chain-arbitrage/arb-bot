{
	"name": "cross-chain-arbitrages",
	"version": "0.0.1",
	"description": "This repository contains the code for the Cross Chain Arbitrage project.",
	"license": "MIT",
	"main": "src/main.ts",
	"scripts": {
		"test": "jest",
		"test:logs": "ENABLE_LOGS=true jest",
		"lint": "npx eslint src",
		"lint:fix": "npx eslint src --fix",
		"check-types": "npx tsc --noEmit",
		"check-pool": "sh test/dex/checkPool/checkPool.sh",
		"build": "npx tsc --project tsconfig.build.json",
		"getPoolStats": "npx tsx src/getPoolStats.ts",
		"monitor": "npx tsx src/monitor.ts",
		"run-bot": "npx tsx src/startGraphArbitrage.ts",
		"approve-all": "npx tsx src/approveAll.ts",
		"arbitrage:weth-pools": "yarn build && node dist/strategies/WethPoolsStrategy/WethPoolsStrategy.js",
		"arbitrage:fuse-pools": "yarn build && node dist/strategies/FusePoolsStrategy/FusePoolsStrategy.js",
		"arbitrage:wbtc-pools": "yarn build && node dist/strategies/WbtcFuseStrategy/WbtcFuseStrategy.js",
		"deploy:weth-pools": "make -f Makefile.wethPools deploy",
		"deploy:pools-monitor": "make -f Makefile deploy"
	},
	"devDependencies": {
		"@eslint/js": "^9.26.0",
		"@types/jest": "^29.5.14",
		"@types/ms": "^2.1.0",
		"@types/node-telegram-bot-api": "^0.64.8",
		"@types/pako": "^2.0.3",
		"eslint": "^9.26.0",
		"jest": "^30.0.2",
		"prettier": "^3.5.3",
		"ts-jest": "^29.4.0",
		"typescript-eslint": "^8.32.0"
	},
	"dependencies": {
		"@isaacs/ttlcache": "^1.4.1",
		"@layerzerolabs/lz-v2-utilities": "^3.0.94",
		"@layerzerolabs/scan-client": "^0.0.8",
		"@lifi/sdk": "^3.7.0",
		"@types/node": "^22.15.3",
		"axios": "^1.10.0",
		"dotenv": "^16.4.5",
		"eslint-plugin-unused-imports": "^4.1.4",
		"get-port": "5",
		"ms": "^2.1.3",
		"node-telegram-bot-api": "^0.66.0",
		"pako": "^2.1.0",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0",
		"prettier-plugin-organize-imports": "^4.1.0",
		"tsx": "^4.10.3",
		"typescript": "^5.8.3",
		"viem": "^2.28.1"
	}
}
